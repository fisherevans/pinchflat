<div class="flex flex-col">
  <div class="mb-5 grid grid-cols-2 gap-3.5 md:grid-cols-4">
    <.stat_tile label="Sources" value={to_string(@summary.source_count)}>
      <:delta>{@summary.active_count} active</:delta>
    </.stat_tile>
    <.stat_tile label="Downloaded" value={to_string(@summary.downloaded)}>
      <:delta>
        <span :if={@summary.week_new > 0} class="text-meta-3">+{@summary.week_new} this week</span>
        <span :if={@summary.week_new == 0} class="text-bodydark2">no new this week</span>
      </:delta>
    </.stat_tile>
    <.stat_tile label="Library" value={"#{Float.round(@summary.total_bytes / 1_000_000_000, 1)} GB"}>
      <:delta>
        <span :if={@summary.week_culled > 0} class="text-meta-1">&minus;{@summary.week_culled} culled</span>
        <span class="text-bodydark2"><.readable_filesize byte_size={@summary.week_freed} /> freed</span>
      </:delta>
    </.stat_tile>
    <.stat_tile
      label="Net this week"
      value={"#{if @summary.week_new - @summary.week_culled >= 0, do: "+", else: ""}#{@summary.week_new - @summary.week_culled}"}
    >
      <:delta>{@summary.week_new} added, {@summary.week_culled} removed</:delta>
    </.stat_tile>
  </div>

  <div class="rounded-sm border border-stroke bg-white shadow-default dark:border-strokedark dark:bg-boxdark">
    <div class="grid grid-cols-[2.2fr_1fr_1.2fr_1.5fr_1.2fr_auto] items-center gap-4 border-b border-stroke px-5 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-bodydark2 dark:border-strokedark">
      <button
        phx-click="sort_update"
        phx-value-sort_key="custom_name"
        class="flex items-center gap-1 text-left hover:text-white"
      >
        Subscription <span :if={@sort_key == :custom_name}>{if @sort_direction == :asc, do: "↑", else: "↓"}</span>
      </button>
      <div>Status</div>
      <button
        phx-click="sort_update"
        phx-value-sort_key="downloaded_count"
        class="flex items-center gap-1 text-left hover:text-white"
      >
        Library <span :if={@sort_key == :downloaded_count}>{if @sort_direction == :asc, do: "↑", else: "↓"}</span>
      </button>
      <div>Library by upload date</div>
      <div>This week</div>
      <div></div>
    </div>

    <div id="source-rows">
      <div
        :for={source <- @sources}
        class="source-row grid grid-cols-[2.2fr_1fr_1.2fr_1.5fr_1.2fr_auto] items-center gap-4 border-b border-stroke px-5 py-4 last:border-0 hover:bg-meta-4/20 dark:border-strokedark"
      >
        <div class="flex min-w-0 items-center gap-3">
          <.source_avatar name={source.custom_name} seed={source.id} />
          <div class="min-w-0">
            <.link
              navigate={~p"/sources/#{source.id}"}
              class="block truncate font-semibold text-black hover:text-primary dark:text-white"
            >
              {source.custom_name}
            </.link>
            <div class="truncate text-xs text-bodydark2">{source.media_profile.name}</div>
          </div>
        </div>

        <div class="flex flex-col items-start gap-2">
          <.status_pill status={status(source)} />
          <.live_component
            module={PinchflatWeb.Sources.SourceLive.SourceEnableToggle}
            source={source}
            id={"source_#{source.id}_enabled"}
          />
        </div>

        <div>
          <div class="text-lg font-bold leading-none text-black dark:text-white">
            <.localized_number number={source.downloaded_count} />
          </div>
          <div class="mt-1 text-[11px] uppercase tracking-wide text-bodydark2">
            downloaded &middot; <.readable_filesize byte_size={source.media_size_bytes} />
          </div>
        </div>

        <div>
          <.sparkline values={source.upload_sparkline} height="30px" />
          <div class="mt-1.5 text-[11px] text-bodydark2">kept &middot; by upload date &middot; last year</div>
        </div>

        <div><.change_badge new={source.recent_downloaded_count} culled={source.recent_culled_count} /></div>

        <div class="flex items-center justify-end gap-3">
          <.icon_link href={~p"/sources/#{source.id}/edit"} icon="hero-pencil-square" />
          <.link navigate={~p"/sources/#{source.id}"} class="text-xl leading-none text-bodydark2 hover:text-white">
            &rsaquo;
          </.link>
        </div>
      </div>
    </div>
  </div>

  <section class="my-5 flex justify-center">
    <.live_pagination_controls page_number={@page} total_pages={@total_pages} />
  </section>
</div>
