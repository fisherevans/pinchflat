<.simple_form :let={f} for={@changeset} action={@action} method={@method}>
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>

  <section x-data="{ mediaProfileId: null }">
    <.tabbed_layout>
      <%!-- 1. SOURCE: what to subscribe to and how to store it --%>
      <:tab title="Source" id="source">
        <p class="mb-5 text-sm text-bodydark">What channel or playlist this is, and how its files are named.</p>

        <.input
          field={f[:original_url]}
          type="text"
          label="Source URL"
          help="URL of a channel or playlist (required)"
          x-init="$el.focus()"
        />

        <.input
          field={f[:custom_name]}
          type="text"
          label="Custom Name"
          help="Does not impact indexing or downloading. Will be inferred from the source if left blank"
        />

        <.input
          field={f[:media_profile_id]}
          options={Enum.map(@media_profiles, &{&1.name, &1.id})}
          type="select"
          label="Media Profile"
          help="Sets your preferences for what media to look for and how to store it"
          x-model.fill="mediaProfileId"
        />

        <section
          x-data={
            """
            {
              placeholders: JSON.parse('#{output_path_template_override_placeholders(@media_profiles)}'),
              inputValue: null
            }
            """
          }
          x-on:load-template="inputValue = placeholders[mediaProfileId]"
        >
          <.input
            field={f[:output_path_template_override]}
            type="text"
            inputclass="font-mono"
            label="Output path template override"
            help={output_path_template_override_help()}
            html_help={true}
            x-bind:placeholder="placeholders[mediaProfileId]"
            x-model.fill="inputValue"
          />
        </section>
      </:tab>

      <%!-- 2. INDEXING: how often to check, and whether to download --%>
      <:tab title="Indexing" id="indexing">
        <p class="mb-5 text-sm text-bodydark">How often Pinchflat checks for new media, and whether it downloads it.</p>

        <section x-data="{ fastIndexingEnabled: null }">
          <.input
            field={f[:index_frequency_minutes]}
            options={friendly_index_frequencies()}
            type="select"
            label="Index Frequency"
            x-bind:disabled="fastIndexingEnabled == true"
            x-init="$watch('fastIndexingEnabled', v => v && ($el.value = 30 * 24 * 60))"
            help="Indexing is the process of checking for media to download. For best results, set this to the longest delay you can tolerate for this source"
          />

          <div phx-click={show_modal("upgrade-modal")}>
            <.input
              field={f[:fast_index]}
              type="toggle"
              label="Use Fast Indexing"
              label_suffix="(pro)"
              help="Not recommended for playlists. Overrides 'Index Frequency'. See below for more details (seriously, there's a TL;DR that's worth reading)"
              x-init="
              // `enabled` is the data attribute that the toggle uses internally
              fastIndexingEnabled = enabled
              $watch('enabled', value => fastIndexingEnabled = !!value)
            "
            />
          </div>
        </section>

        <.input
          field={f[:download_media]}
          type="toggle"
          label="Download Media"
          help="Unchecking still indexes media but it won't be downloaded until you enable this option"
        />

        <.input
          field={f[:cookie_behaviour]}
          options={friendly_cookie_behaviours()}
          type="select"
          label="Cookie Behaviour"
          help="Uses your YouTube cookies for this source (if configured). 'When Needed' tries to minimize cookie usage except for certain indexing and downloading tasks. See docs"
        />

        <div class="mt-6 rounded-sm p-4 dark:bg-meta-4 md:p-6">
          <.fast_indexing_help />
        </div>
      </:tab>

      <%!-- 3. FILTERING: which media is a viable download --%>
      <:tab title="Filtering" id="filtering">
        <p class="mb-5 text-sm text-bodydark">
          Decide which media is even a viable download. Drag the duration range and add title/description rules;
          the live preview at the bottom updates as you go. What survives here flows on to Limits.
        </p>

        <% filter_breakdown_url =
          if @changeset.data.id, do: ~p"/sources/#{@changeset.data.id}/filter_breakdown", else: "" %>
        <section
          class="mt-2"
          data-config={filter_config_json(f[:filter_config].value)}
          data-include={f[:title_filter_regex].value}
          data-exclude={f[:title_exclude_regex].value}
          x-data={
            """
            {
              url: '#{filter_breakdown_url}',
              match: 'all',
              rules: [],
              include: '',
              exclude: '',
              loaded: false,
              error: false,
              minDur: #{f[:min_duration_seconds].value || "null"},
              maxDur: #{f[:max_duration_seconds].value || "null"},
              durReady: false,
              bd: { total: 0, matched: 0, excluded: 0, cadence: [], matched_titles: [], excluded_titles: [], durations: { axis_max: 0, bin_seconds: 0, bins: [] }, include: null, exclude: null },
              init() {
                this.include = this.$el.dataset.include || '';
                this.exclude = this.$el.dataset.exclude || '';
                try {
                  const cfg = JSON.parse(this.$el.dataset.config || '{}');
                  this.match = cfg.match || 'all';
                  this.rules = Array.isArray(cfg.rules) ? cfg.rules : [];
                } catch (e) {}
                // Field edits and slider drags bubble input/change events to the section's
                // debounced handler; only programmatic array changes need an explicit watch.
                this.$watch('rules', () => this.refresh());
                this.refresh();
              },
              addRule() { this.rules.push({ field: 'title', operator: 'excludes', value: '' }); },
              removeRule(i) { this.rules.splice(i, 1); },
              opsFor(field) { return field === 'duration' ? 'duration' : 'text'; },
              onFieldChange(rule) { rule.operator = rule.field === 'duration' ? 'longer_than' : 'excludes'; },
              configJson() { return JSON.stringify({ match: this.match, rules: this.rules }); },
              ciOn(which) { return (this[which] || '').startsWith('(?i)'); },
              toggleCi(which) { this[which] = this.ciOn(which) ? this[which].slice(4) : '(?i)' + (this[which] || ''); },
              fmtDur(s) {
                if (s === null || s === undefined) return '-';
                s = Math.round(s);
                const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
                const p = (n) => String(n).padStart(2, '0');
                return h > 0 ? h + ':' + p(m) + ':' + p(sec) : m + ':' + p(sec);
              },
              durAxis() { return this.bd.durations.axis_max || 0; },
              durLo() { return this.minDur === null ? 0 : this.minDur; },
              durHi() { return this.maxDur === null ? this.durAxis() : this.maxDur; },
              onMinDur(v) { this.minDur = Math.min(v, this.durHi()); },
              onMaxDur(v) { this.maxDur = Math.max(v, this.durLo()); },
              durMinParam() { return (this.minDur && this.minDur > 0) ? this.minDur : ''; },
              durMaxParam() { const ax = this.durAxis(); return (this.maxDur !== null && ax && this.maxDur < ax) ? this.maxDur : ''; },
              durMaxBin() { return Math.max(1, ...this.bd.durations.bins, 1); },
              durBarH(c) { return (c / this.durMaxBin()) * 100; },
              durBinIn(i) { const bs = this.bd.durations.bin_seconds || 0; return (i + 1) * bs > this.durLo() && i * bs < this.durHi(); },
              durPct(v) { const ax = this.durAxis(); return ax ? (v / ax) * 100 : 0; },
              maxMonth() { let m = 0; for (const b of this.bd.cadence) { const t = b.matched + b.excluded; if (t > m) m = t; } return m || 1; },
              barStyle(b) { const t = b.matched + b.excluded; const h = t ? Math.max(3, (t / this.maxMonth()) * 100) : 0; return 'height:' + h + '%'; },
              segStyle(part, b) { const t = b.matched + b.excluded; const h = t ? (b[part] / t) * 100 : 0; const col = part === 'excluded' ? '#e5534b' : '#3fb950'; return 'height:' + h + '%;background:' + col; },
              async refresh() {
                if (!this.url) return;
                const q = new URLSearchParams({
                  title_filter_regex: this.include || '',
                  title_exclude_regex: this.exclude || '',
                  min_duration_seconds: this.durMinParam(),
                  max_duration_seconds: this.durMaxParam(),
                  config: this.configJson()
                });
                try {
                  const res = await fetch(this.url + '?' + q.toString());
                  if (!res.ok) { this.error = true; this.loaded = true; return; }
                  const d = await res.json();
                  if (d.error) { this.error = true; this.loaded = true; return; }
                  this.error = false; this.bd = d; this.loaded = true;
                  const ax = this.durAxis();
                  if (!this.durReady && ax > 0) {
                    if (this.minDur === null) this.minDur = 0;
                    if (this.maxDur === null) this.maxDur = ax;
                    this.durReady = true;
                  }
                } catch (e) { this.error = true; this.loaded = true; }
              }
            }
            """
          }
          x-on:input.debounce.400ms="refresh()"
          x-on:change="refresh()"
        >
          <%!-- Duration range: histogram on top, dual-range slider underneath, values under each thumb --%>
          <div class="mb-6 rounded-xl border border-stroke p-4 dark:border-strokedark dark:bg-meta-4/30">
            <div class="mb-3 flex items-center gap-1 text-sm font-semibold text-black dark:text-white">
              Duration range
              <.info_tip text="Each bar is how many videos fall at that length. Drag the handles to set a minimum and maximum; videos outside the range are filtered out. A handle at either end means no bound." />
            </div>

            <div x-show="durReady" x-cloak>
              <%!-- histogram --%>
              <div class="mx-[9px] flex h-16 items-end gap-px">
                <template x-for="(c, i) in bd.durations.bins" x-bind:key="i">
                  <div
                    class="flex-1 rounded-t-sm transition-colors"
                    x-bind:class="durBinIn(i) ? 'bg-[#3fb950]' : 'bg-bodydark2/25'"
                    x-bind:style="'height:' + durBarH(c) + '%'"
                  >
                  </div>
                </template>
              </div>
              <%!-- slider track --%>
              <div class="relative h-5">
                <div class="absolute inset-x-[9px] top-1/2 h-1 -translate-y-1/2">
                  <div class="absolute inset-0 rounded bg-bodydark2/25"></div>
                  <div
                    class="absolute h-full rounded bg-[#3fb950]"
                    x-bind:style="'left:' + durPct(durLo()) + '%; right:' + (100 - durPct(durHi())) + '%'"
                  >
                  </div>
                </div>
                <input
                  type="range"
                  class="range-overlay"
                  min="0"
                  x-bind:max="durAxis()"
                  x-bind:step="bd.durations.bin_seconds || 1"
                  x-bind:value="durLo()"
                  x-on:input="onMinDur(+$event.target.value)"
                />
                <input
                  type="range"
                  class="range-overlay"
                  min="0"
                  x-bind:max="durAxis()"
                  x-bind:step="bd.durations.bin_seconds || 1"
                  x-bind:value="durHi()"
                  x-on:input="onMaxDur(+$event.target.value)"
                />
              </div>
              <%!-- value under each thumb --%>
              <div class="relative mx-[9px] h-5">
                <span
                  class="absolute -translate-x-1/2 whitespace-nowrap font-mono text-[11px] font-semibold text-black dark:text-white"
                  x-bind:style="'left:' + durPct(durLo()) + '%'"
                  x-text="durLo() > 0 ? fmtDur(durLo()) : 'no min'"
                >
                </span>
                <span
                  class="absolute -translate-x-1/2 whitespace-nowrap font-mono text-[11px] font-semibold text-black dark:text-white"
                  x-bind:style="'left:' + durPct(durHi()) + '%'"
                  x-text="(durAxis() && durHi() < durAxis()) ? fmtDur(durHi()) : 'no max'"
                >
                </span>
              </div>
              <div class="mx-[9px] flex justify-between font-mono text-[11px] text-bodydark2">
                <span>0:00</span>
                <span x-text="fmtDur(durAxis())"></span>
              </div>
            </div>
            <p x-show="!durReady" class="text-xs text-bodydark2">
              Reindex this source's metadata to see the length distribution.
            </p>

            <input
              type="hidden"
              id="source_min_duration_seconds"
              name="source[min_duration_seconds]"
              x-bind:value="durMinParam()"
            />
            <input
              type="hidden"
              id="source_max_duration_seconds"
              name="source[max_duration_seconds]"
              x-bind:value="durMaxParam()"
            />
          </div>

          <%!-- Title filters, side by side, with verbose guidance behind an info icon --%>
          <div class="mb-2 flex items-center gap-1 text-sm font-semibold text-black dark:text-white">
            Title filters
            <.info_tip text="PCRE-compatible regexes matched against the video title. 'Must match' only keeps titles that match; 'Must not match' drops titles that match (use foo|bar to list several terms). The Aa toggle controls case sensitivity. Leave blank to skip." />
          </div>
          <div class="grid gap-4 md:grid-cols-2">
            <.title_regex_field
              id="source_title_filter_regex"
              name="source[title_filter_regex]"
              model="include"
              label="Must match (include)"
              color="#3fb950"
              placeholder="^How to Bike$"
            />
            <.title_regex_field
              id="source_title_exclude_regex"
              name="source[title_exclude_regex]"
              model="exclude"
              label="Must not match (exclude)"
              color="#e5534b"
              placeholder="compilation|best of|#shorts"
            />
          </div>

          <div class="mb-3 mt-5 flex flex-wrap items-center gap-2 text-sm">
            <span class="flex items-center gap-1 font-semibold">
              Rules
              <.info_tip text="Build extra conditions on title, description, or duration. 'Match all' requires every rule; 'match any' requires at least one. These stack with the title filters above." />
            </span>
            &mdash; match
            <select
              x-model="match"
              class="rounded border border-stroke bg-transparent px-3 py-1.5 dark:border-strokedark dark:bg-meta-4"
            >
              <option value="all">all rules</option>
              <option value="any">any rule</option>
            </select>
            <span>of the following:</span>
          </div>

          <template x-for="(rule, i) in rules" x-bind:key="i">
            <div class="mb-2 flex flex-wrap items-center gap-2">
              <select
                x-model="rule.field"
                x-on:change="onFieldChange(rule)"
                class="rounded border border-stroke bg-transparent px-3 py-1.5 dark:border-strokedark dark:bg-meta-4"
              >
                <option value="title">Title</option>
                <option value="description">Description</option>
                <option value="duration">Duration</option>
              </select>
              <template x-if="opsFor(rule.field) === 'text'">
                <select
                  x-model="rule.operator"
                  class="rounded border border-stroke bg-transparent px-3 py-1.5 dark:border-strokedark dark:bg-meta-4"
                >
                  <option value="contains">contains</option>
                  <option value="excludes">excludes</option>
                </select>
              </template>
              <template x-if="opsFor(rule.field) === 'duration'">
                <select
                  x-model="rule.operator"
                  class="rounded border border-stroke bg-transparent px-3 py-1.5 dark:border-strokedark dark:bg-meta-4"
                >
                  <option value="longer_than">longer than (sec)</option>
                  <option value="shorter_than">shorter than (sec)</option>
                </select>
              </template>
              <input
                type="text"
                x-model="rule.value"
                x-bind:placeholder="rule.field === 'duration' ? 'seconds' : 'regex e.g. (?i)compilation'"
                class="min-w-40 flex-1 rounded border border-stroke bg-transparent px-3 py-1.5 dark:border-strokedark dark:bg-meta-4"
              />
              <button
                type="button"
                x-on:click="removeRule(i)"
                class="rounded border border-stroke px-2.5 py-1.5 hover:text-meta-1 dark:border-strokedark"
                title="Remove rule"
              >
                &times;
              </button>
            </div>
          </template>

          <button type="button" x-on:click="addRule()" class="mt-1 text-sm text-primary hover:underline">
            + Add rule
          </button>

          <input type="hidden" name="source[filter_config_json]" x-bind:value="configJson()" />

          <div x-show="error" x-cloak class="mt-4 text-sm text-meta-1">
            Invalid filter pattern - fix the regex to see the preview
          </div>

          <div
            x-show="loaded && !error"
            x-cloak
            class="mt-6 rounded-xl border border-stroke p-4 dark:border-strokedark dark:bg-boxdark"
          >
            <div class="mb-3 flex flex-wrap items-baseline gap-3 text-sm">
              <span class="font-mono text-xs font-semibold uppercase tracking-wider text-bodydark2">Live preview</span>
              <span><span class="font-bold" style="color:#3fb950" x-text="bd.matched"></span> downloading</span>
              <span><span class="font-bold" style="color:#e5534b" x-text="bd.excluded"></span> filtered out</span>
              <span class="opacity-60">of <span x-text="bd.total"></span></span>
            </div>

            <div class="flex h-24 items-end gap-px overflow-x-auto border-b border-stroke pb-px dark:border-strokedark">
              <template x-for="(b, i) in bd.cadence" x-bind:key="i">
                <div
                  class="flex w-1.5 shrink-0 flex-col justify-end"
                  x-bind:style="barStyle(b)"
                  x-bind:title="b.month + ': ' + b.matched + ' in, ' + b.excluded + ' out'"
                >
                  <div class="rounded-t-sm" x-bind:style="segStyle('excluded', b)"></div>
                  <div x-bind:style="segStyle('matched', b)"></div>
                </div>
              </template>
            </div>
            <div class="mt-1 flex justify-between text-xs opacity-70" x-show="bd.cadence.length">
              <span x-text="bd.cadence[0] && bd.cadence[0].month"></span>
              <span x-text="bd.cadence.length && bd.cadence[bd.cadence.length - 1].month"></span>
            </div>

            <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-2">
              <div>
                <div class="mb-1 text-xs font-bold" style="color:#3fb950">
                  Will download (<span x-text="bd.matched"></span>)
                </div>
                <ul class="max-h-48 overflow-y-auto rounded border border-stroke text-xs dark:border-strokedark">
                  <template x-for="(t, i) in bd.matched_titles" x-bind:key="i">
                    <li
                      class="flex items-center justify-between gap-2 border-b border-stroke px-2 py-1 dark:border-strokedark"
                      x-bind:title="t.title"
                    >
                      <span class="truncate" x-text="t.title"></span>
                      <span class="shrink-0 font-mono text-bodydark2" x-text="fmtDur(t.duration)"></span>
                    </li>
                  </template>
                </ul>
                <p
                  class="mt-1 text-xs opacity-60"
                  x-show="bd.matched > bd.matched_titles.length"
                  x-text="'+ ' + (bd.matched - bd.matched_titles.length) + ' more'"
                >
                </p>
              </div>
              <div>
                <div class="mb-1 text-xs font-bold" style="color:#e5534b">
                  Filtered out (<span x-text="bd.excluded"></span>)
                </div>
                <ul class="max-h-48 overflow-y-auto rounded border border-stroke text-xs dark:border-strokedark">
                  <template x-for="(t, i) in bd.excluded_titles" x-bind:key="i">
                    <li
                      class="flex items-center justify-between gap-2 border-b border-stroke px-2 py-1 dark:border-strokedark"
                      x-bind:title="t.title"
                    >
                      <span class="truncate" x-text="t.title"></span>
                      <span class="shrink-0 font-mono text-bodydark2" x-text="fmtDur(t.duration)"></span>
                    </li>
                  </template>
                </ul>
                <p
                  class="mt-1 text-xs opacity-60"
                  x-show="bd.excluded > bd.excluded_titles.length"
                  x-text="'+ ' + (bd.excluded - bd.excluded_titles.length) + ' more'"
                >
                </p>
              </div>
            </div>
          </div>
        </section>
      </:tab>

      <%!-- 4. LIMITS: of the viable media, how much to keep --%>
      <:tab title="Limits" id="limits">
        <p class="mb-5 text-sm text-bodydark">
          Of the media that passed Filtering, how much to keep - by time, size, and count. Pinchflat keeps the
          library inside these limits automatically.
        </p>

        <%!-- Time window: drag two handles across the upload-cadence timeline --%>
        <% months_js = @cadence |> Enum.map(& &1.month) |> Phoenix.json_library().encode!() %>
        <% max_count = if @cadence == [], do: 1, else: @cadence |> Enum.map(& &1.count) |> Enum.max() %>
        <section x-data={
            """
            {
              cutoffDate: '#{f[:download_cutoff_date].value}',
              endDate: '#{f[:download_end_date].value}',
              months: #{months_js},
              monthIdx(date) { if (!date) return -1; return this.months.indexOf(date.slice(0, 7)); },
              fromIdx() { const i = this.monthIdx(this.cutoffDate); return i < 0 ? 0 : i; },
              untilIdx() { const i = this.monthIdx(this.endDate); return i < 0 ? this.months.length - 1 : i; },
              pct(i) { const n = this.months.length; return n > 1 ? (i / (n - 1)) * 100 : 0; },
              inWindow(i) { return i >= this.fromIdx() && i <= this.untilIdx(); },
              monthEnd(ym) { const a = ym.split('-').map(Number); const d = new Date(a[0], a[1], 0).getDate(); return ym + '-' + String(d).padStart(2, '0'); },
              onFrom(i) { i = Math.min(i, this.untilIdx()); this.cutoffDate = i <= 0 ? '' : this.months[i] + '-01'; },
              onUntil(i) { i = Math.max(i, this.fromIdx()); this.endDate = (i >= this.months.length - 1) ? '' : this.monthEnd(this.months[i]); }
            }
            """
          }>
          <div class="mb-1 flex items-center gap-1 text-xl font-bold">
            Time window
            <.info_tip text="Only keep media uploaded inside this date range. Drag the handles across the upload timeline, or type exact dates below. A handle at either end means no bound on that side." />
          </div>
          <p class="mb-3 text-sm opacity-70">
            Each bar is a month of uploads; the highlighted span is what's in the window.
          </p>

          <div :if={@cadence != []} class="mb-5">
            <%!-- histogram --%>
            <div class="mx-[9px] flex h-28 items-end gap-px">
              <div
                :for={{bucket, i} <- Enum.with_index(@cadence)}
                class="flex-1 rounded-t-sm transition-colors"
                style={"height: #{cadence_bar_pct(bucket.count, max_count)}%"}
                title={"#{bucket.month}: #{bucket.count} uploads"}
                x-bind:class={"inWindow(#{i}) ? 'bg-primary' : 'bg-bodydark2/25'"}
              >
              </div>
            </div>
            <%!-- slider track --%>
            <div class="relative h-5">
              <div class="absolute inset-x-[9px] top-1/2 h-1 -translate-y-1/2">
                <div class="absolute inset-0 rounded bg-bodydark2/25"></div>
                <div
                  class="absolute h-full rounded bg-primary"
                  x-bind:style="'left:' + pct(fromIdx()) + '%; right:' + (100 - pct(untilIdx())) + '%'"
                >
                </div>
              </div>
              <input
                type="range"
                class="range-overlay"
                min="0"
                x-bind:max="months.length - 1"
                step="1"
                x-bind:value="fromIdx()"
                x-on:input="onFrom(+$event.target.value)"
              />
              <input
                type="range"
                class="range-overlay"
                min="0"
                x-bind:max="months.length - 1"
                step="1"
                x-bind:value="untilIdx()"
                x-on:input="onUntil(+$event.target.value)"
              />
            </div>
            <div class="mx-[9px] mt-1 flex justify-between text-xs text-bodydark2">
              <span x-text="cutoffDate ? cutoffDate.slice(0, 7) : months[0]"></span>
              <span>peak {max_count}/mo</span>
              <span x-text="endDate ? endDate.slice(0, 7) : months[months.length - 1]"></span>
            </div>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <.input
              field={f[:download_cutoff_date]}
              type="text"
              label="From (cutoff date)"
              placeholder="YYYY-MM-DD"
              maxlength="10"
              pattern="((?:19|20)[0-9][0-9])-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])"
              title="YYYY-MM-DD"
              help="Only keep media uploaded on or after this date. Leave blank for no start bound"
              x-model="cutoffDate"
            >
              <:input_append>
                <.input
                  prompt="preset"
                  name="download_cutoff_date_preset"
                  value=""
                  options={cutoff_date_presets()}
                  type="select"
                  inputclass="w-28 ml-2"
                  x-on:change={"cutoffDate = $event.target.value || '#{f[:download_cutoff_date].value}'"}
                />
              </:input_append>
            </.input>

            <.input
              field={f[:download_end_date]}
              type="text"
              label="Until (end date)"
              placeholder="YYYY-MM-DD"
              maxlength="10"
              pattern="((?:19|20)[0-9][0-9])-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])"
              title="YYYY-MM-DD"
              help="Only keep media uploaded on or before this date. Leave blank for no end bound"
              x-model="endDate"
            />
          </div>
        </section>

        <% curve_url = if @changeset.data.id, do: ~p"/sources/#{@changeset.data.id}/retention_curve", else: "" %>
        <section
          class="mt-8"
          x-data={
            """
            {
              url: '#{curve_url}',
              items: [],
              total: 0,
              downloadedCount: 0,
              downloadedBytes: 0,
              avgB: 0,
              loaded: false,
              keepCount: '#{f[:keep_count].value}',
              keepGb: '#{gigabytes_from_bytes(f[:keep_bytes].value)}',
              strategy: '#{f[:eviction_strategy].value}',
              init() {
                this.$watch('strategy', () => this.fetchCurve());
                this.fetchCurve();
              },
              async fetchCurve() {
                if (!this.url) { this.loaded = true; return; }
                try {
                  const res = await fetch(this.url + '?eviction_strategy=' + encodeURIComponent(this.strategy));
                  const d = await res.json();
                  this.items = d.items || [];
                  this.total = d.total || 0;
                  this.downloadedCount = d.downloaded_count || 0;
                  this.downloadedBytes = d.downloaded_bytes || 0;
                  this.avgB = d.avg_bytes || 0;
                  this.loaded = true;
                } catch (e) { this.loaded = true; }
              },
              gb(v) { return v.toFixed(1) + ' GB'; },
              cum(n) { let s = 0; for (let i = 0; i < n && i < this.items.length; i++) s += this.items[i].bytes; return s; },
              allBytes() { return this.cum(this.items.length); },
              gbForCount(n) { return (n <= this.items.length) ? this.cum(n) / 1e9 : (this.allBytes() + this.avgB * (n - this.total)) / 1e9; },
              countForGb(g) {
                const cap = g * 1e9; let s = 0, i = 0;
                for (; i < this.items.length; i++) { s += this.items[i].bytes; if (s > cap) break; }
                if (i < this.items.length) return i;
                return this.avgB > 0 ? this.total + Math.floor((cap - this.allBytes()) / this.avgB) : i;
              },
              niceCeil(v) {
                if (v <= 10) return 10;
                const mag = Math.pow(10, Math.floor(Math.log10(v)));
                const n = v / mag, step = n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10;
                return step * mag;
              },
              gbNiceCeil(v) { if (v <= 1) return Math.max(0.5, Math.ceil(v * 10) / 10); if (v <= 10) return Math.ceil(v); return this.niceCeil(v); },
              countAxis() { return this.niceCeil(Math.max(this.total * 1.5, this.total + 25, parseInt(this.keepCount) || 0)); },
              gbAxis() { return this.gbNiceCeil(Math.max((this.allBytes() / 1e9) * 1.5, parseFloat(this.keepGb) || 0, 0.5)); },
              kcNum() { return this.keepCount === '' ? Infinity : (parseInt(this.keepCount) || 0); },
              gbNum() { return this.keepGb === '' ? Infinity : (parseFloat(this.keepGb) || 0); },
              sizeCapCount() { return this.keepGb === '' ? Infinity : this.countForGb(this.gbNum()); },
              effKeepRaw() { return Math.min(this.kcNum(), this.sizeCapCount()); },
              keptNow() { return Math.min(this.effKeepRaw(), this.total); },
              keptEst() { let n = 0; const k = this.keptNow(); for (let i = 0; i < k && i < this.items.length; i++) if (this.items[i].est) n++; return n; },
              keepLabel() {
                if (this.strategy === 'newest') return 'Keep earliest';
                if (this.strategy === 'shortest') return 'Keep longest';
                if (this.strategy === 'longest') return 'Keep shortest';
                return 'Keep most recent';
              },
              maxBytes() { return Math.max(1, ...this.items.map(it => it.bytes), 1); },
              barH(i) { return Math.sqrt(this.items[i].bytes / this.maxBytes()) * 100; },
              barClass(i) { if (i >= this.keptNow()) return 'bg-meta-1/60'; return this.items[i].est ? 'bg-meta-3/40' : 'bg-meta-3'; },
              noCount() { return this.keepCount === ''; },
              noGb() { return this.keepGb === ''; },
              toggleNoCount() { this.keepCount = (this.keepCount === '') ? String(Math.min(this.total || 25, this.countAxis())) : ''; },
              toggleNoGb() { this.keepGb = (this.keepGb === '') ? String(this.gbNiceCeil((this.allBytes() / 1e9) || 0.5)) : ''; }
            }
            """
          }
        >
          <div class="mb-1 flex items-center gap-1 text-xl font-bold">
            Capacity
            <.info_tip text="Cap the kept library by count and/or size. The most restrictive cap wins; whatever falls outside it is evicted using the strategy below. The count cap also limits what gets downloaded. Sliders run past your current library so you can leave room to grow." />
          </div>
          <p class="mb-3 text-sm opacity-70">
            The strip is your whole indexed library, ordered by the eviction strategy. Sizes for items you haven't
            downloaded yet are estimated from the average of those you have.
          </p>
          <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-bodydark2">
            <span class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-sm bg-meta-3"></span> kept · downloaded
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-sm bg-meta-3/40"></span> kept · estimated
            </span>
            <span class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-sm bg-meta-1/60"></span> evicted
            </span>
          </div>

          <%!-- Prospective-library strip: every indexed item, real size where known, estimated otherwise --%>
          <div x-show="loaded && total > 0" x-cloak class="mb-5">
            <div class="flex h-20 items-end gap-px overflow-hidden rounded-md border border-stroke bg-meta-4/20 p-1 dark:border-strokedark">
              <template x-for="(it, i) in items" x-bind:key="i">
                <div
                  class="min-w-px flex-1 rounded-t-sm transition-colors"
                  x-bind:class="barClass(i)"
                  x-bind:style="'height:' + Math.max(4, barH(i)) + '%'"
                >
                </div>
              </template>
            </div>
            <div class="mt-2 rounded-md border border-stroke px-4 py-2.5 text-sm font-medium dark:border-strokedark dark:bg-meta-4">
              <span class="text-meta-3" x-text="'Keep ' + keptNow()"></span>
              <span class="opacity-60" x-text="' of ' + total + ' (≈' + gb(cum(keptNow()) / 1e9) + ')'"></span>
              <span
                x-show="keptNow() < total"
                class="text-meta-1"
                x-text="' · evict ' + (total - keptNow()) + ' (≈' + gb((allBytes() - cum(keptNow())) / 1e9) + ' freed)'"
              >
              </span>
              <div class="mt-0.5 text-xs font-normal text-bodydark2">
                <span x-text="downloadedCount + ' downloaded so far'"></span>
                <span
                  x-show="keptEst() > 0"
                  x-text="' · ' + keptEst() + ' of the kept set not downloaded yet (size estimated)'"
                >
                </span>
              </div>
            </div>
          </div>

          <div x-show="loaded" x-cloak class="grid gap-6 md:grid-cols-2">
            <%!-- Keep count --%>
            <div>
              <div class="mb-1 flex items-baseline justify-between gap-2 text-sm">
                <label class="flex items-center gap-1.5 font-semibold">
                  <span x-text="keepLabel()"></span>
                  <span class="font-normal text-bodydark2">(count)</span>
                </label>
                <label class="flex cursor-pointer items-center gap-1.5 text-xs text-bodydark2">
                  <input type="checkbox" class="rounded" x-bind:checked="noCount()" x-on:change="toggleNoCount()" />
                  no limit
                </label>
              </div>
              <input
                type="range"
                min="0"
                x-bind:max="countAxis()"
                step="1"
                x-bind:value="noCount() ? countAxis() : kcNum()"
                x-bind:disabled="noCount()"
                x-on:input="keepCount = String(+$event.target.value)"
                class="h-2 w-full cursor-pointer appearance-none rounded-full bg-meta-4 accent-primary disabled:opacity-40"
              />
              <div class="mt-1 font-mono text-xs text-bodydark2">
                <span x-show="noCount()">No count limit</span>
                <span x-show="!noCount()">
                  <span class="font-semibold text-black dark:text-white" x-text="kcNum() + ' items'"></span>
                  <span x-text="'≈ ' + gb(gbForCount(kcNum())) + (kcNum() > downloadedCount ? ' (est)' : '')"></span>
                </span>
              </div>
            </div>
            <%!-- Max size --%>
            <div>
              <div class="mb-1 flex items-baseline justify-between gap-2 text-sm">
                <label class="font-semibold">
                  Maximum total size <span class="font-normal text-bodydark2">(GB)</span>
                </label>
                <label class="flex cursor-pointer items-center gap-1.5 text-xs text-bodydark2">
                  <input type="checkbox" class="rounded" x-bind:checked="noGb()" x-on:change="toggleNoGb()" /> no limit
                </label>
              </div>
              <input
                type="range"
                min="0"
                x-bind:max="gbAxis()"
                step="0.1"
                x-bind:value="noGb() ? gbAxis() : gbNum()"
                x-bind:disabled="noGb()"
                x-on:input="keepGb = String(+$event.target.value)"
                class="h-2 w-full cursor-pointer appearance-none rounded-full bg-meta-4 accent-primary disabled:opacity-40"
              />
              <div class="mt-1 font-mono text-xs text-bodydark2">
                <span x-show="noGb()">No size limit</span>
                <span x-show="!noGb()">
                  <span class="font-semibold text-black dark:text-white" x-text="gb(gbNum())"></span>
                  <span x-text="'≈ ' + sizeCapCount() + ' items' + (sizeCapCount() > downloadedCount ? ' (est)' : '')">
                  </span>
                </span>
              </div>
            </div>
          </div>

          <p x-show="loaded && total === 0" x-cloak class="mt-3 text-xs text-bodydark2">
            Nothing indexed yet, so there's no library to measure - the sliders use a default range. These caps still
            apply once content is indexed, and the count cap also limits what gets downloaded.
          </p>

          <%!-- These hidden fields are what actually submit --%>
          <input type="hidden" name="source[keep_count]" id="source_keep_count" x-bind:value="keepCount" />
          <input type="hidden" name="source[keep_gigabytes]" id="source_keep_gigabytes" x-bind:value="keepGb" />

          <%!-- Eviction: which to keep/evict, plus the time-based retention cap --%>
          <h4 class="mb-3 mt-7 text-sm font-semibold text-black dark:text-white">Eviction</h4>
          <div class="grid items-start gap-4 md:grid-cols-2">
            <.input
              field={f[:eviction_strategy]}
              options={eviction_strategies()}
              type="select"
              label="Eviction strategy"
              x-model="strategy"
              help="Which media to keep, and which to evict first when over budget"
            />

            <div x-data="{ days: '#{f[:retention_period_days].value}' }">
              <div class="mb-2 flex items-center gap-1 text-md font-medium text-black dark:text-white">
                Retention period
                <.info_tip text="Delete media this many days after it was downloaded, regardless of count or size. Leave blank to keep until the count/size caps force eviction." />
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <input
                  type="number"
                  name="source[retention_period_days]"
                  id="source_retention_period_days"
                  min="0"
                  x-model="days"
                  placeholder="no limit"
                  class="w-28 rounded-lg border-[1.5px] border-form-strokedark bg-form-input px-4 py-3 text-white outline-none transition focus:border-primary"
                />
                <span class="text-sm text-bodydark2">days</span>
                <div class="flex flex-wrap gap-1.5">
                  <button
                    :for={{label, value} <- [{"30d", "30"}, {"90d", "90"}, {"6mo", "180"}, {"1yr", "365"}, {"∞", ""}]}
                    type="button"
                    x-on:click={"days = '#{value}'"}
                    x-bind:class={"days === '#{value}' ? 'border-primary text-primary' : 'border-stroke dark:border-strokedark text-bodydark2'"}
                    class="rounded-full border px-2.5 py-1 text-xs font-medium hover:text-primary"
                  >
                    {label}
                  </button>
                </div>
              </div>
            </div>

            <.input
              field={f[:max_delete_percent]}
              type="number"
              label="Max delete percent (safety guard)"
              min="0"
              max="100"
              help="Skip eviction if a single run would remove more than this percent of downloaded media. Leave blank to disable"
            />
          </div>
        </section>
      </:tab>
    </.tabbed_layout>
  </section>

  <.button class="my-10 w-full sm:mb-7.5 sm:w-auto" rounding="rounded-lg">Save Source</.button>
</.simple_form>
