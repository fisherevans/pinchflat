<.simple_form
  :let={f}
  for={@changeset}
  action={@action}
  x-data="{ advancedMode: !!JSON.parse(localStorage.getItem('advancedMode')) }"
  x-init="$watch('advancedMode', value => localStorage.setItem('advancedMode', JSON.stringify(value)))"
>
  <.error :if={@changeset.action}>
    Oops, something went wrong! Please check the errors below.
  </.error>

  <section>
    <section class="flex justify-between items-center mt-4">
      <h3 class="text-2xl text-black dark:text-white">
        Notification Settings
      </h3>
      <span class="cursor-pointer hover:underline" x-on:click="advancedMode = !advancedMode">
        Editing Mode: <span x-text="advancedMode ? 'Advanced' : 'Standard'"></span>
      </span>
    </section>

    {live_render(
      @conn,
      Pinchflat.Settings.AppriseServerLive,
      session: %{"value" => f[:apprise_server].value}
    )}
  </section>

  <section class="mt-8">
    <section>
      <h3 class="text-2xl text-black dark:text-white">
        Extractor Settings
      </h3>

      <.input
        field={f[:youtube_api_key]}
        placeholder="ABC123,DEF456"
        type="text"
        label="YouTube API Key(s)"
        help={youtube_api_help()}
        html_help={true}
        inputclass="font-mono text-sm mr-4"
      />

      <.input
        field={f[:extractor_sleep_interval_seconds]}
        placeholder="0"
        type="number"
        label="Sleep Interval (seconds)"
        help="Sleep interval in seconds between each extractor request. Must be a positive whole number. Set to 0 to disable"
      />

      <.input
        field={f[:download_throughput_limit]}
        placeholder="4.2M"
        label="Download Throughput"
        help="Sets the max bytes-per-second throughput when downloading media. Examples: '50K' or '4.2M'. Leave blank to disable"
      />

      <.input
        field={f[:restrict_filenames]}
        type="toggle"
        label="Restrict Filenames"
        help="Restrict filenames to only ASCII characters and avoid ampersands/spaces in filenames"
      />
    </section>
  </section>

  <section class="mt-8">
    <section>
      <h3 class="text-2xl text-black dark:text-white">
        Media Center Integration
      </h3>

      <p class="mt-2 max-w-prose text-sm">
        Trigger a Plex and/or Jellyfin library refresh after Pinchflat reorganizes files or you replace a poster.
        Leave a server's fields blank to skip it.
      </p>

      <.input
        field={f[:plex_url]}
        placeholder="http://10.0.0.10:32400"
        type="text"
        label="Plex URL"
        inputclass="font-mono text-sm"
      />
      <.input
        field={f[:plex_token]}
        type="text"
        label="Plex Token"
        help="Your X-Plex-Token. See the Plex docs for how to find it"
        inputclass="font-mono text-sm"
      />
      <.input
        field={f[:plex_library_section]}
        placeholder="4"
        type="text"
        label="Plex Library Section ID"
        help="The numeric section ID of the library Pinchflat writes to"
      />

      <.input
        field={f[:jellyfin_url]}
        placeholder="http://10.0.0.10:8096"
        type="text"
        label="Jellyfin URL"
        inputclass="font-mono text-sm"
      />
      <.input
        field={f[:jellyfin_token]}
        type="text"
        label="Jellyfin API Key"
        help="A Jellyfin API key (Dashboard -> API Keys). Sent as the MediaBrowser token"
        inputclass="font-mono text-sm"
      />
    </section>
  </section>

  <section class="mt-8">
    <section>
      <h3 class="text-2xl text-black dark:text-white">
        Title Cleaning
      </h3>
      <p class="mt-2 max-w-prose text-sm text-bodydark">
        A global chain of rules applied to every source's titles before that source's own rules
        (unless a source opts out on its Titles tab). Good for blanket cleanups like stripping
        emojis or collapsing whitespace - keep source-specific rules on each source.
      </p>
    </section>

    <div class="mt-5">
      <.title_clean_chain_editor
        url={~p"/settings/title_clean_preview"}
        submit_name="setting[title_clean_global_chain_json]"
        seed_steps={f[:title_clean_global_chain].value || %{"steps" => []}}
        empty_text="No indexed media yet to preview against."
        show_global={false}
      />
    </div>
  </section>

  <section class="mt-8" x-show="advancedMode">
    <section>
      <h3 class="text-2xl text-black dark:text-white">
        Codec Options
      </h3>

      <p class="text-sm mt-2 max-w-prose">
        The best available codec will be used if your preferred codecs are not found
      </p>

      <.input
        field={f[:video_codec_preference]}
        placeholder="avc"
        type="text"
        label="Video Codec Preference"
        help="Video codec preference. Will be remuxed into an MP4 container. See below for more details"
        inputclass="font-mono text-sm mr-4"
      />

      <.input
        field={f[:audio_codec_preference]}
        placeholder="m4a"
        type="text"
        label="Audio Codec Preference"
        help="Audio codec preference. See below for more details"
        inputclass="font-mono text-sm mr-4"
      />
    </section>

    <div class="rounded-sm dark:bg-meta-4 p-4 md:p-6 mt-5">
      <.codec_settings_help />
    </div>
  </section>

  <.button class="mt-10 mb-4 sm:mb-8 w-full sm:w-auto" rounding="rounded-lg">Save Settings</.button>
</.simple_form>
